# RunPod Inference API Endpoint (e.g., https://<pod-id>-8000.proxy.runpod.net or http://127.0.0.1:8000)
RUNPOD_ENDPOINT_URL=http://127.0.0.1:8000

# RunPod API Key & Pod ID (Optional, for auto-stop and direct pod start/stop)
RUNPOD_API_KEY=
RUNPOD_POD_ID=

# GPU Hourly Cost in USD (e.g. 0.33 for RTX A6000 Community Cloud)
GPU_HOURLY_COST=0.33

# Auto Stop Inactivity Timeout in minutes (0 to disable)
AUTO_STOP_MINUTES=30

# Provider Type: "mock" (zero-cost local test) or "runpod" (remote GPU pod)
PROVIDER_TYPE=mock
